@{ ViewData["Title"] = "Iniciar sesión"; }
<section class="login-stage">
    <div class="login-story">
        <div class="story-mark"><i class="fas fa-shield-halved"></i></div>
        <div class="eyebrow">LOGICSTORE</div>
        <h1>La tecnología que hace avanzar tu espacio.</h1>
        <p>Encuentra periféricos y equipos informáticos para trabajar, crear y disfrutar cada día.</p>
        <div class="story-rule"></div>
        <span class="story-note">Periféricos · Equipos · Accesorios</span>
    </div>
    <div class="login-card">
        <div class="login-header">
            <span class="login-kicker">Tu cuenta LogicStore</span>
            <h2>Iniciar sesión</h2>
            <p class="text-muted">Accede para continuar con tu experiencia de compra.</p>
        </div>
        <div asp-validation-summary="All" class="text-danger" role="alert"></div>
        <form asp-action="Login" method="post">
            <label for="username"><i class="fas fa-user"></i> Usuario</label>
            <input id="username" name="username" required autocomplete="username" class="form-control" placeholder="ej. cliente-a" />
            <label for="password"><i class="fas fa-lock"></i> Contraseña</label>
            <input id="password" name="password" type="password" required autocomplete="current-password" class="form-control" />
            <button class="btn btn-dark w-100 mt-4"><i class="fas fa-right-to-bracket"></i> Entrar</button>
        </form>
        <p class="small mt-4"><i class="fas fa-info-circle"></i> Mantén tus credenciales seguras y no las compartas.</p>
    </div>
</section>
