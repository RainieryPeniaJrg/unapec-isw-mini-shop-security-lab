@model OrderResponse
@{ ViewData["Title"] = "Pedido " + Model.Id; }
<div class="eyebrow">PEDIDO SINTÉTICO</div><h1>Pedido #@Model.Id</h1><p>Cliente #@Model.UserId · @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</p><table class="table"><thead><tr><th>Producto</th><th>Cantidad</th><th>Precio congelado</th></tr></thead><tbody>@foreach (var line in Model.Items) { <tr><td>@line.Name</td><td>@line.Quantity</td><td>RD$ @((line.PriceCents / 100m).ToString("N2"))</td></tr> }</tbody></table><p class="price">Total: RD$ @((Model.TotalCents / 100m).ToString("N2"))</p><a href="/Orders">Ver mis pedidos</a>
