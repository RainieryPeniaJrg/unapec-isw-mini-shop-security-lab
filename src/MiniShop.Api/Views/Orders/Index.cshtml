@model List<OrderResponse>
@{ ViewData["Title"] = "Mis pedidos"; }
<div class="eyebrow"><i class="fas fa-receipt"></i> HISTORIAL</div>
<h1>Mis pedidos</h1>
@if (Model.Count == 0) {
    <p class="mt-4"><i class="fas fa-inbox"></i> Aún no tienes pedidos. <a href="/Products">Visita el catálogo</a>.</p>
}
@foreach (var order in Model) {
    <a href="/Orders/Details/@order.Id" class="order-card">
        <div>
            <div class="order-id"><i class="fas fa-file-invoice"></i> Pedido #@order.Id</div>
            <div class="order-date">@order.CreatedAt.ToString("dd MMM yyyy · HH:mm")</div>
        </div>
        <div class="order-total">RD$ @((order.TotalCents / 100m).ToString("N2"))</div>
    </a>
}
