@model List<OrderResponse>
@{ ViewData["Title"] = "Mis pedidos"; }
<h1>Mis pedidos</h1>@if (Model.Count == 0) { <p>Aún no tienes pedidos. <a href="/Products">Visita el catálogo</a>.</p> }
@foreach (var order in Model) { <article class="comment"><a href="/Orders/Details/@order.Id">Pedido #@order.Id</a> · @order.CreatedAt.ToString("yyyy-MM-dd HH:mm") · RD$ @((order.TotalCents / 100m).ToString("N2"))</article> }
