@model ProductResponse
@inject LabOptions Lab
@{ ViewData["Title"] = Model.Name; var comments = (List<CommentResponse>)ViewBag.Comments; }
<a href="/Products" class="back-link"><i class="fas fa-arrow-left"></i> Volver al catálogo</a>
<div class="detail mt-4">
    <div class="detail-visual">
        <div class="product-art large" aria-hidden="true">▧</div>
        <span class="detail-caption">Producto de la colección demo · #@Model.Id</span>
    </div>
    <section class="detail-content">
        <div class="eyebrow"><i class="fas fa-tag"></i> PRODUCTO #@Model.Id</div>
        <h1>@Model.Name</h1>
        <p class="lead">@Model.Description</p>
        <div class="detail-buy">
            <div><div class="price-label">Precio unitario</div><p class="price">RD$ @((Model.PriceCents / 100m).ToString("N2"))</p></div>
            @if (User.IsInRole("Cliente")) {
                <form asp-controller="Cart" asp-action="Add" method="post">
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <label for="quantity"><i class="fas fa-hashtag"></i> Cantidad</label>
                    <input id="quantity" name="quantity" type="number" value="1" min="1" max="99" class="form-control quantity" />
                    <button class="btn btn-dark mt-3"><i class="fas fa-cart-plus"></i> Agregar al carrito</button>
                </form>
            } else if (User.Identity?.IsAuthenticated != true) {
                <a href="/Account/Login" class="btn btn-gold mt-3"><i class="fas fa-right-to-bracket"></i> Inicia sesión para comprar</a>
            }
        </div>
    </section>
</div>
<section class="comments">
    <div class="section-heading"><div><div class="eyebrow"><i class="fas fa-comments"></i> CONVERSACIÓN</div><h2>Comentarios <span class="text-muted">(@comments.Count)</span></h2></div></div>
    @foreach (var comment in comments) {
        <article class="comment">
            <strong><i class="fas fa-user-circle"></i> @comment.Username</strong>
            <div>@if (Lab.RedTeam) { @Html.Raw(comment.Body) } else { @comment.Body }</div>
        </article>
    }
    @if (User.Identity?.IsAuthenticated == true) {
        <form asp-action="Comment" method="post" class="comment-form mt-4">
            <input type="hidden" name="id" value="@Model.Id" />
            <label for="body"><i class="fas fa-pen"></i> Comparte un comentario</label>
            <textarea id="body" name="body" required maxlength="4000" class="form-control" rows="3" placeholder="Escribe tu opinión sobre este producto..."></textarea>
            <button class="btn btn-dark mt-3"><i class="fas fa-paper-plane"></i> Publicar comentario</button>
        </form>
    } else {
        <p class="mt-3"><a href="/Account/Login"><i class="fas fa-right-to-bracket"></i> Inicia sesión</a> para comentar.</p>
    }
</section>
