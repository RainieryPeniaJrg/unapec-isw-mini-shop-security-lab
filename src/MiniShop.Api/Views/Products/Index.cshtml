@model List<ProductResponse>
@{ ViewData["Title"] = "Catálogo"; }
<div class="eyebrow">LA TIENDA DEL LABORATORIO</div><h1>Productos para practicar.</h1><p class="lead">Explora el catálogo y recorre una compra con datos sintéticos.</p>
<form method="get" class="search"><label for="q">Buscar productos</label><div class="input-group"><input id="q" name="q" value="@ViewBag.Query" class="form-control" placeholder="Prueba con demo" /><button class="btn btn-dark">Buscar</button></div></form>
<p class="text-muted mt-4">@Model.Count productos</p><div class="product-grid">
@foreach (var product in Model) { <article class="card"><div class="product-art" aria-hidden="true">@(product.Id % 3 == 1 ? "⌨" : product.Id % 3 == 2 ? "◉" : "▤")</div><div class="card-body"><h2 class="h4">@product.Name</h2><p>@product.Description</p><div class="price">RD$ @((product.PriceCents / 100m).ToString("N2"))</div><a class="btn btn-outline-dark mt-3" href="/Products/Details/@product.Id">Ver producto</a></div></article> }
</div>@if (Model.Count == 0) { <p>No encontramos productos. Prueba otra búsqueda.</p> }
