@model ProductResponse
@{ ViewData["Title"] = Model.Id == 0 ? "Crear producto" : "Editar producto"; }
<h1>@ViewData["Title"]</h1><div asp-validation-summary="All" class="text-danger"></div><form asp-action="Save" method="post" class="editor"><input type="hidden" name="id" value="@Model.Id" /><label for="name">Nombre</label><input id="name" name="name" value="@Model.Name" maxlength="120" required class="form-control" /><label for="description">Descripción</label><textarea id="description" name="description" maxlength="2000" class="form-control" rows="4">@Model.Description</textarea><label for="price">Precio en centavos (RD$)</label><input id="price" name="priceCents" type="number" min="1" max="100000000" value="@Model.PriceCents" required class="form-control" /><button class="btn btn-dark mt-4">Guardar producto</button><a href="/Seller/Products" class="btn btn-outline-dark mt-4">Cancelar</a></form>
