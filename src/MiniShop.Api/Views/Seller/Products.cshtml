@model List<ProductResponse>
@{ ViewData["Title"] = "Gestionar productos"; }
<section class="page-heading with-action">
    <div><div class="eyebrow"><i class="fas fa-boxes-stacked"></i> PANEL DE PRODUCTOS</div><h1>@(User.IsInRole("Admin") ? "Todos los productos" : "Mis productos")</h1></div>
    <a href="/Seller/Edit" class="btn btn-dark"><i class="fas fa-plus"></i> Crear producto</a>
</section>
<div class="table-responsive">
    <table class="table">
        <thead><tr><th><i class="fas fa-box"></i> Producto</th><th><i class="fas fa-tag"></i> Precio</th><th><i class="fas fa-user"></i> Vendedor</th><th><i class="fas fa-gear"></i> Acciones</th></tr></thead>
        <tbody>
        @foreach (var product in Model) {
            <tr>
                <td><strong>@product.Name</strong></td>
                <td>RD$ @((product.PriceCents / 100m).ToString("N2"))</td>
                <td>#@product.SellerId</td>
                <td class="inline-form">
                    <a href="/Seller/Edit/@product.Id" class="btn btn-outline-dark"><i class="fas fa-pen"></i> Editar</a>
                    <form asp-action="Delete" method="post">
                        <input type="hidden" name="id" value="@product.Id" />
                        <button class="btn btn-outline-danger"><i class="fas fa-trash-alt"></i> Eliminar</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
