@inject LabOptions Lab
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · UNAPEC Mini Shop</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="app-shell">
    <div class="topbar">
        <span>Universidad APEC</span> — Seguridad de Software ISW — Laboratorio Demo Educativa
    </div>
    <header>
        <nav class="container navbar">
            <a class="brand" href="/Products">
                <div class="brand-icon"><i class="fas fa-shield-halved"></i></div>
                <div>UNAPEC Mini Shop<span>Proyecto Integrador · Laboratorio de Seguridad</span></div>
            </a>
            <div class="nav-links">
                <a href="/Products"><i class="fas fa-store"></i> <span>Catálogo</span></a>
                @if (User.IsInRole("Cliente")) {
                    <a href="/Cart"><i class="fas fa-cart-shopping"></i> <span>Carrito</span></a>
                    <a href="/Orders"><i class="fas fa-receipt"></i> <span>Pedidos</span></a>
                }
                @if (User.IsInRole("Vendedor") || User.IsInRole("Admin")) {
                    <a href="/Seller/Products"><i class="fas fa-boxes-stacked"></i> <span>Productos</span></a>
                }
                @if (User.IsInRole("Admin")) {
                    <a href="/Admin"><i class="fas fa-gauge-high"></i> <span>Admin</span></a>
                }
                @if (User.Identity?.IsAuthenticated == true) {
                    <a href="/Account/Profile"><i class="fas fa-user-circle"></i> <span>@User.Identity.Name</span></a>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button class="btn-nav-logout" type="submit"><i class="fas fa-right-from-bracket"></i> Salir</button>
                    </form>
                } else {
                    <a class="btn-nav-login" href="/Account/Login"><i class="fas fa-right-to-bracket"></i> Iniciar sesión</a>
                }
            </div>
        </nav>
    </header>
    <div class="lab-banner @(Lab.RedTeam ? "redteam" : "blueteam")">
        <i class="fas @(Lab.RedTeam ? "fa-triangle-exclamation" : "fa-flask")"></i>
        @(Lab.RedTeam ? "RED TEAM · Fallas intencionales activas · Solo datos ficticios y loopback" : "Laboratorio local · Escenarios Red Team desactivados")
    </div>
    <main class="container page-container">@RenderBody()</main>
    <footer class="container">
        <div class="footer-left"><i class="fas fa-shield-halved"></i> UNAPEC Mini Shop Security Lab · Proyecto Integrador · Fase 1</div>
        <div class="footer-right">UNAPEC · ISW · 2026</div>
    </footer>
</body>
</html>
