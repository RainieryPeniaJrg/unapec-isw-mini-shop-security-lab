@inject LabOptions Lab
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · LogicStore</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body class="app-shell">
    <div class="topbar">
        <span>LogicStore</span> — Tecnología e informática — Periféricos y equipos
    </div>
    <header>
        <nav class="container navbar">
            <a class="brand" href="/Products">
                <div class="brand-icon"><i class="fas fa-shield-halved"></i></div>
                <div>LogicStore<span>Periféricos y equipos informáticos</span></div>
            </a>
            <div class="nav-links">
                <a href="/Products"><i class="fas fa-store"></i> <span>Catálogo</span></a>
                @if (User.IsInRole("Cliente")) {
                    <a href="/Cart"><i class="fas fa-cart-shopping"></i> <span>Carrito</span></a>
                    <a href="/Orders"><i class="fas fa-receipt"></i> <span>Pedidos</span></a>
                }
                @if (User.IsInRole("Vendedor") || User.IsInRole("Admin")) {
                    <a href="/Seller/Products"><i class="fas fa-boxes-stacked"></i> <span>Productos</span></a>
                }
                @if (User.IsInRole("Admin")) {
                    <a href="/Admin"><i class="fas fa-gauge-high"></i> <span>Admin</span></a>
                }
                @if (User.Identity?.IsAuthenticated == true) {
                    <a href="/Account/Profile"><i class="fas fa-user-circle"></i> <span>@User.Identity.Name</span></a>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button class="btn-nav-logout" type="submit"><i class="fas fa-right-from-bracket"></i> Salir</button>
                    </form>
                } else {
                    <a class="btn-nav-login" href="/Account/Login"><i class="fas fa-right-to-bracket"></i> Iniciar sesión</a>
                }
            </div>
        </nav>
    </header>
    <div class="lab-banner @(Lab.RedTeam ? "redteam" : "blueteam")">
        <i class="fas @(Lab.RedTeam ? "fa-triangle-exclamation" : "fa-flask")"></i>
        @(Lab.RedTeam ? "Entorno Red Team: habilitado · Solo pruebas locales" : "Entorno Red Team: no habilitado · Operación normal")
    </div>
    <main class="container page-container">@RenderBody()</main>
    <footer>
        <div class="container footer-inner">
            <div class="footer-left"><span class="footer-brand-mark"><i class="fas fa-shield-halved"></i></span><span><strong>LogicStore</strong><small>Tu tienda de tecnología</small></span></div>
            <div class="footer-right">Periféricos · Equipos · Accesorios</div>
        </div>
    </footer>
</body>
</html>
